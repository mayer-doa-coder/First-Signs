# Copy this file to .env.local for local development. Do not commit .env.local.
# Replace every placeholder with your own value. Never add NEXT_PUBLIC_ to secrets.

# Required for the persisted screening, referral, care, pharmacy, and dashboard flows.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-only-supabase-secret
# Required for optional passwordless accounts. The publishable key is safe for browser use;
# never use the secret/service-role key with NEXT_PUBLIC_. Configure the listed HTTPS callback
# URL in Supabase Auth redirect URLs and configure Resend SMTP there for magic links/invites.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-public-key

# Optional generic account reminders. Never include health details in reminder email.
RESEND_API_KEY=replace-with-your-server-only-resend-key
REMINDER_FROM_EMAIL=First%20Signs%20%3Creminders@your-domain.example%3E
# Use this only for a scheduled POST to /api/reminders/send with the same request header.
REMINDER_CRON_SECRET=replace-with-a-private-random-token

# Required for stable public QR links. Use HTTPS in production.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Required to use the demo TB-centre verification screen.
TB_CENTRE_STAFF_PIN=replace-with-a-private-demo-pin

# Optional: AI companion. The fixed rules still work without this.
GEMINI_API_KEY=replace-with-your-server-only-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: the TB-first assistant refreshes excerpts only from its approved
# WHO/Bangladesh NTP source allow-list. Set false to use bundled source cards.
HEALTH_ASSISTANT_WEB_RETRIEVAL=true

# Optional: real HeAR acoustic processing. Both values are required together.
# HEAR_SERVICE_URL=http://127.0.0.1:8017
# HEAR_SERVICE_TOKEN=replace-with-a-private-random-token
# Optional: valid research-only triage artifacts auto-enable in the separate
# service. Do not set the TBscreen terms flag unless you have separately read
# and accepted the dataset's terms for the intended use.
# HEAR_TRIAGE_CLASSIFIER_PATH=/absolute/path/to/tb_triage_classifier.json
# TBSCREEN_DATA_TERMS_CONFIRMED=yes

# Optional: Telegram webhook. This requires a public HTTPS deployment.
# APP_URL=https://your-domain.example
# MESSAGING_ID_SECRET=replace-with-a-random-32-plus-character-secret
# TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Generate a 32-byte URL-safe random value. Telegram returns it in a request
# header; it is not a BotFather setting and must match the value used by setWebhook.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-url-safe-random-webhook-secret
# Optional one-deployment overlap when rotating the webhook secret.
# TELEGRAM_WEBHOOK_SECRET_PREVIOUS=previous-url-safe-webhook-secret
# TELEGRAM_BOT_USERNAME=your_bot_username
